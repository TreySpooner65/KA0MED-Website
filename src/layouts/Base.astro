---
import '../styles/global.css';
const { title='KA0MED', description='Amateur radio, explained from the field.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title} | KA0MED</title></head>
<body><header class="site-header"><a class="brand" href={base}><span class="mark">K0</span><span><b>KA0MED</b><small>FIELD NOTES FOR THE AIRWAVES</small></span></a><nav aria-label="Primary"><a href={`${base}reviews/`}>Reviews</a><a href={`${base}technical/`}>Technical</a><a href={`${base}encyclopedia/`}>Encyclopedia</a><a class="app-link" href={`${base}field-programmer/`}>Field Programmer</a></nav></header><main><slot /></main><footer><div><b>KA0MED</b><p>Amateur radio knowledge built in the Missouri Ozarks.</p></div><div class="footer-links"><a href={`${base}reviews/`}>Reviews</a><a href={`${base}technical/`}>Technical Articles</a><a href={`${base}encyclopedia/`}>Encyclopedia</a></div><p class="fine">© {new Date().getFullYear()} KA0MED</p></footer></body></html>
