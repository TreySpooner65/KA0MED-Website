---
import Base from '../layouts/Base.astro';
import app from '../data/field-programmer.json';
---
<Base title="Field Programmer"><section class="app-hero"><div><p class="eyebrow">{app.kicker}</p><h1>{app.heroTitle}<br/><em>{app.heroAccent}</em><br/>{app.heroFinalLine}</h1><p>{app.description}</p><a class="button" href="#radios">{app.buttonLabel}</a></div><div class="fp-badge"><span>FP</span><b>FIELD<br/>PROGRAMMER</b><small>BY KA0MED</small></div></section><section class="section"><div class="feature-grid"><div><b>01</b><h3>{app.featureOneTitle}</h3><p>{app.featureOneDescription}</p></div><div><b>02</b><h3>{app.featureTwoTitle}</h3><p>{app.featureTwoDescription}</p></div><div><b>03</b><h3>{app.featureThreeTitle}</h3><p>{app.featureThreeDescription}</p></div></div><div id="radios" class="supported"><p class="eyebrow">{app.supportedKicker}</p><h2>{app.supportedTitle}</h2><div class="chips">{app.supportedRadios.map((radio) => <span>{radio}</span>)}</div></div></section></Base>
