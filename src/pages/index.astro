---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
const base=import.meta.env.BASE_URL;
const featured=(await getCollection('editorial')).filter(x=>x.data.featured).slice(0,3);
---
<Base title="Amateur Radio, Explained from the Field"><section class="hero"><div class="hero-copy"><p class="kicker">AMATEUR RADIO • MISSOURI OZARKS</p><h1>Get on the air.<br/><em>Know your gear.</em></h1><p class="lead">Practical reviews, technical field notes, and a plain-language encyclopedia for new and experienced radio operators.</p><div class="actions"><a class="button" href={`${base}encyclopedia/`}>Explore the encyclopedia</a><a class="text-link" href={`${base}field-programmer/`}>Meet Field Programmer →</a></div></div><div class="signal-panel" aria-label="Radio signal illustration"><div class="rings"></div><div class="radio"><div class="antenna"></div><div class="radio-face"><small>VHF / UHF</small><strong>146.520</strong><span>KA0MED • SIMPLEX</span></div><div class="knob"></div></div><p><span class="dot"></span> MONITORING THE CALLING FREQUENCY</p></div></section><section class="trail"><div><b>START HERE</b><span>New to amateur radio?</span></div><a href={`${base}encyclopedia/`}>Learn the language</a><a href={`${base}technical/`}>Build your first station</a><a href={`${base}reviews/`}>Choose your equipment</a></section><section class="section"><div class="section-head"><div><p class="eyebrow">FROM THE FIELD</p><h2>Latest reports</h2></div><a href={`${base}reviews/`}>View all writing →</a></div><div class="grid">{featured.map(item=><Card href={`${base}${item.data.category==='Review'?'reviews':'technical'}/${item.id}/`} eyebrow={item.data.category} title={item.data.title} description={item.data.description} tags={item.data.tags}/>)}</div></section><section class="split"><div><p class="eyebrow">THE RADIO ENCYCLOPEDIA</p><h2>No jargon left unexplained.</h2><p>A growing A–Z reference written for the operator holding a radio in one hand and a question in the other.</p><a class="button light" href={`${base}encyclopedia/`}>Browse A–Z</a></div><div class="definition"><span>R</span><div><small>REPEATER</small><p>A station that receives a signal on one frequency and retransmits it on another, extending its usable range.</p></div></div></section><section class="app-banner"><div><p class="eyebrow">FIELD PROGRAMMER FOR ANDROID</p><h2>Program your radio.<br/>Leave the laptop behind.</h2><p>Offline radio programming built for the field—simple, focused, and expanding to support more radios.</p><a class="button" href={`${base}field-programmer/`}>Explore the app</a></div><div class="phone"><div class="phone-top"></div><p>FIELD PROGRAMMER</p><h3>Radios</h3><div class="radio-row"><span>UV</span><b>UV-5R Family</b><i>›</i></div><div class="radio-row"><span>32</span><b>UV-32</b><i>›</i></div><div class="radio-row"><span>DM</span><b>DM-32</b><i>›</i></div></div></section></Base>
