---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import home from '../data/homepage.json';
const base=import.meta.env.BASE_URL;
const featured=(await getCollection('editorial')).filter(x=>x.data.featured).slice(0,3);
---
<Base title="Amateur Radio, Explained from the Field"><section class="hero"><div class="hero-copy"><p class="kicker">{home.kicker}</p><h1>{home.heroTitle}<br/><em>{home.heroAccent}</em></h1><p class="lead">{home.heroDescription}</p><div class="actions"><a class="button" href={`${base}encyclopedia/`}>{home.primaryButtonLabel}</a><a class="text-link" href={`${base}field-programmer/`}>{home.secondaryButtonLabel} →</a></div></div><div class="signal-panel" aria-label="Radio signal illustration"><div class="rings"></div><div class="radio"><div class="antenna"></div><div class="radio-face"><small>VHF / UHF</small><strong>{home.callingFrequency}</strong><span>KA0MED • SIMPLEX</span></div><div class="knob"></div></div><p><span class="dot"></span> {home.monitoringStatus}</p></div></section><section class="trail"><div><b>{home.startHereTitle}</b><span>{home.startHereSubtitle}</span></div><a href={`${base}encyclopedia/`}>Learn the language</a><a href={`${base}technical/`}>Build your first station</a><a href={`${base}reviews/`}>Choose your equipment</a></section><section class="section"><div class="section-head"><div><p class="eyebrow">{home.latestKicker}</p><h2>{home.latestTitle}</h2></div><a href={`${base}reviews/`}>View all writing →</a></div><div class="grid">{featured.map(item=><Card href={`${base}${item.data.category==='Review'?'reviews':'technical'}/${item.id}/`} eyebrow={item.data.category} title={item.data.title} description={item.data.description} tags={item.data.tags}/>)}</div></section><section class="split"><div><p class="eyebrow">{home.encyclopediaKicker}</p><h2>{home.encyclopediaTitle}</h2><p>{home.encyclopediaDescription}</p><a class="button light" href={`${base}encyclopedia/`}>Browse A–Z</a></div><div class="definition"><span>{home.featuredLetter}</span><div><small>{home.featuredTerm}</small><p>{home.featuredDefinition}</p></div></div></section><section class="app-banner"><div><p class="eyebrow">{home.appKicker}</p><h2>{home.appTitle}</h2><p>{home.appDescription}</p><a class="button" href={`${base}field-programmer/`}>{home.appButtonLabel}</a></div><div class="phone"><div class="phone-top"></div><p>FIELD PROGRAMMER</p><h3>Radios</h3><div class="radio-row"><span>UV</span><b>UV-5R Family</b><i>›</i></div><div class="radio-row"><span>32</span><b>UV-32</b><i>›</i></div><div class="radio-row"><span>DM</span><b>DM-32</b><i>›</i></div></div></section></Base>
