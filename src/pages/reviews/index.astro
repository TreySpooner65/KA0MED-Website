---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import {getCollection} from 'astro:content'; const base=import.meta.env.BASE_URL; const posts=(await getCollection('editorial')).filter(x=>x.data.category==='Review').sort((a,b)=>+b.data.date-+a.data.date);
---
<Base title="Radio Reviews" description="Hands-on amateur radio equipment reviews."><section class="page-hero"><p class="eyebrow">TESTED IN THE REAL WORLD</p><h1>Radio Reviews</h1><p>Practical assessments focused on what equipment is like to own, carry, program, and use in the field.</p></section><section class="section"><div class="grid">{posts.map(p=><Card href={`${base}reviews/${p.id}/`} eyebrow={p.data.date.toLocaleDateString()} title={p.data.title} description={p.data.description} tags={p.data.tags}/>)}</div></section></Base>
