---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('editorial'))
    .filter((entry) => entry.data.category === 'Review')
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="article">
    <p class="eyebrow">REVIEW • {entry.data.date.toLocaleDateString()}</p>
    <h1>{entry.data.title}</h1>
    <p class="dek">{entry.data.description}</p>
    {entry.data.image && <img class="article-hero" src={entry.data.image} alt={entry.data.title} />}
    <div class="prose"><Content /></div>
  </article>
</Base>
