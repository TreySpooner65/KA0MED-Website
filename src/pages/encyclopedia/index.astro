---
import Base from '../../layouts/Base.astro'; import {getCollection} from 'astro:content'; import {sitePath} from '../../utils/paths'; const entries=(await getCollection('encyclopedia')).sort((a,b)=>a.data.title.localeCompare(b.data.title));
---
<Base title="Amateur Radio Encyclopedia"><section class="page-hero"><p class="eyebrow">A PLAIN-LANGUAGE A–Z</p><h1>Amateur Radio Encyclopedia</h1><p>Terms, systems, and operating concepts explained for people who are still learning the language of radio.</p></section><section class="section"><div class="alphabet">{'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map(l=><a href={`#${l}`}>{l}</a>)}</div><div class="glossary">{entries.map(e=><article id={e.data.letter}><span>{e.data.letter}</span><div><p class="eyebrow">{e.data.category}</p><h2><a href={sitePath(`encyclopedia/${e.id}/`)}>{e.data.title}</a></h2><p>{e.data.description}</p></div></article>)}</div></section></Base>
