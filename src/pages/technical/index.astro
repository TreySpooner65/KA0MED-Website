---
import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import {getCollection} from 'astro:content'; const base=import.meta.env.BASE_URL; const posts=(await getCollection('editorial')).filter(x=>x.data.category==='Technical Article').sort((a,b)=>+b.data.date-+a.data.date);
---
<Base title="Technical Articles"><section class="page-hero"><p class="eyebrow">BUILD • TEST • UNDERSTAND</p><h1>Technical Articles</h1><p>Clear explanations, experiments, and field guides for becoming a more capable radio operator.</p></section><section class="section"><div class="grid">{posts.map(p=><Card href={`${base}technical/${p.id}/`} eyebrow={p.data.date.toLocaleDateString()} title={p.data.title} description={p.data.description} tags={p.data.tags}/>)}</div></section></Base>
